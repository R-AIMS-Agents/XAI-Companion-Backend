# LiveKit server. `livekit-server --dev` listens here and accepts the devkey/secret pair below.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=ai-companion

# Mistral, for Voxtral transcription and the chat model.
MISTRAL_API_KEY=

# ElevenLabs, for speech.
ELEVENLABS_API_KEY=

# NVIDIA NGC, only to build the local Nemotron container (see README).
NGC_API_KEY=
